  "calculationDefinitions": {
    "sleepOpportunityMinutes": "minutes between attemptedSleepAt and outOfBedAt",
    "terminalWakeMinutes": "minutes between finalWakeAt and outOfBedAt",
    "estimatedTotalSleepMinutes": "sleepOpportunity - sleepOnsetLatency - wakeAfterSleepOnset - terminalWake; null when required inputs are missing; clamp only for display error handling, not to hide invalid data",
    "sleepEfficiencyPercent": "estimatedTotalSleepMinutes / sleepOpportunityMinutes * 100; display only when both are valid",
    "dailyTotalSleepMinutes": "mainSleep estimatedTotalSleepMinutes plus completed nap durations",
    "differenceFromSelectedGoalMinutes": "dailyTotalSleepMinutes - locally selected goal; never label as physiologic sleep debt",
    "scheduleVariability": "descriptive variability of local sleep-start and wake clock times after midnight-unwrapping around the period median; no universal good/bad threshold",
    "readinessSummary": "no calculated readiness score; dimensions remain separate; optional overall readiness is directly entered by the user"
  },
  "adultSleepReference": {
    "id": "adult_7_plus_hours_consensus",
    "minimumRegularHours": 7,
    "population": "generally healthy adults",
    "sourceId": "src_aasm_sleep_duration_2015",
    "displayRule": "Show as population guidance, not an individual prescription or diagnostic threshold."
  },
