    "title": "General 5K Foundation Plan",
    "entityType": "cardio_plan_template",
    "publicationStatus": "published",
    "population": "Adults beginning a walk\u2013run progression, using their own comfortable pace; not a clinical prescription.",
    "prerequisites": [
      "Choose a safe route and a timer. Speak to a qualified health professional before starting if concerned about your health."
    ],
    "limitations": [
      "The source progression ends at 30 minutes of running, not a guaranteed 5 km distance. Stretching is excluded from the stated session totals.",
      "A time-based schedule is not medical clearance, a heart-rate target or a claim of guaranteed injury prevention. No machine-generated programme or personal physiological estimate is used."
    ],
    "stopRules": [
      "Stop if something does not feel right; symptoms override the scheduled duration. Seek appropriate help for concerning symptoms."
    ],
    "claims": [
      {
        "id": "claim_source_9_week_running_schedule",
        "text": "The linked source schedule contains nine weeks of three runs, with a rest day between runs. Early weeks alternate running and walking; the final week has 30-minute runs. Each session includes a five-minute warm-up walk and a five-minute cooldown walk.",
