{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitness-os.local/schemas/phase-12-recovery-sleep-mobility.schema.json",
  "title": "Fitness OS Phase 12 Recovery, Sleep and Mobility Backup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportedAt",
    "moduleId",
    "sleepLogs",
    "recoveryCheckIns",
    "mobilitySessions",
    "customRoutineVersions",
    "settings",
    "auditEvents"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\."
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "moduleId": {
      "const": "phase_12_recovery_sleep_mobility"
    },
    "sleepLogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sleepLog"
      }
    },
    "recoveryCheckIns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recoveryCheckIn"
      }
    },
    "mobilitySessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mobilitySession"
      }
    },
    "customRoutineVersions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/customRoutineVersion"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/settingRecord"
      }
    },
    "auditEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auditEvent"
      }
    },
    "deletedRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deletedRecord"
      },
      "default": []
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100
    },
    "rating1to5": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "rating0to10": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sleepLog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sleepDate",
        "timezone",
        "source",
        "createdAt",
        "updatedAt",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "sleepDate": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "manual_recall",
            "manual_morning_diary",
            "consumer_device_estimate"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "complete",
            "incomplete",
            "archived"
          ]
        },
        "gotIntoBedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptedSleepAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "sleepOnsetLatencyMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 720
        },
        "awakeningsCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "wakeAfterSleepOnsetMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1440
        },
        "finalWakeAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "outOfBedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "calculated": {
          "$ref": "#/$defs/sleepCalculated"
        },
        "naps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nap"
          }
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "restedness": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "daytimeSleepiness": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "enum": [
              "late_caffeine",
              "alcohol",
              "late_intense_exercise",
              "travel",
              "shift_work",
              "illness",
              "high_stress",
              "device_estimate",
              "other"
            ]
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        },
        "deviceName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "sleepCalculated": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sleepOpportunityMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1440
        },
        "terminalWakeMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1440
        },
        "estimatedTotalSleepMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1440
        },
        "sleepEfficiencyPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "dailyTotalSleepMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1440
        },
        "calculationVersion": {
          "type": "string"
        },
        "validationWarnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startAt",
        "endAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "startAt": {
          "$ref": "#/$defs/timestamp"
        },
        "endAt": {
          "$ref": "#/$defs/timestamp"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "recoveryCheckIn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "timezone",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string"
        },
        "overallReadiness": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "energy": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "generalFatigue": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "stress": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "motivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "mood": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "perceivedRecovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "regionalSoreness": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regionalSoreness"
          }
        },
        "painOrInjuryConcern": {
          "type": "boolean",
          "default": false
        },
        "painConcernSeverity": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating0to10"
            },
            {
              "type": "null"
            }
          ]
        },
        "illnessSymptoms": {
          "type": "boolean",
          "default": false
        },
        "alertCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linkedSleepLogId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkedWorkoutSessionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "regionalSoreness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "severity"
      ],
      "properties": {
        "regionId": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/rating0to10"
        },
        "laterality": {
          "enum": [
            "left",
            "right",
            "bilateral",
            "midline",
            "not_applicable"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "mobilitySession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "routineId",
        "routineVersionId",
        "startedAt",
        "timezone",
        "completedStepIds",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "routineId": {
          "type": "string"
        },
        "routineVersionId": {
          "type": "string"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "endedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": "string"
        },
        "completedStepIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skippedStepIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "perceivedDifficulty": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating1to5"
            },
            {
              "type": "null"
            }
          ]
        },
        "discomfortConcern": {
          "type": "boolean",
          "default": false
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "customRoutineVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "routineIdentityId",
        "versionNumber",
        "title",
        "context",
        "steps",
        "createdAt",
        "publicationStatus"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "routineIdentityId": {
          "$ref": "#/$defs/uuid"
        },
        "versionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "context": {
          "type": "string"
        },
        "publicationStatus": {
          "enum": [
            "local_draft",
            "local_active",
            "archived"
          ]
        },
        "estimatedMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 180
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routineStep"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "routineStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "doseType",
        "doseValue"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "phase03ExerciseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "doseType": {
          "enum": [
            "repetitions",
            "seconds",
            "breaths",
            "distance",
            "ramp_up_set"
          ]
        },
        "doseValue": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sides": {
          "enum": [
            "none",
            "left_right",
            "alternating",
            "bilateral"
          ]
        },
        "intensityCue": {
          "type": "string",
          "maxLength": 500
        },
        "techniqueCue": {
          "type": "string",
          "maxLength": 1000
        },
        "stopSignals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternativeExerciseIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "settingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "value",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "key": {
          "type": "string"
        },
        "value": {},
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entityType",
        "entityId",
        "action",
        "at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "entityType": {
          "type": "string"
        },
        "entityId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "deletedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityType",
        "entityId",
        "deletedAt"
      ],
      "properties": {
        "entityType": {
          "type": "string"
        },
        "entityId": {
          "type": "string"
        },
        "deletedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}